APP_NAME=DevLens API
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_DB=devlens
POSTGRES_USER=devlens
POSTGRES_PASSWORD=devlens-dev-password
DATABASE_URL=postgresql+psycopg://devlens:devlens-dev-password@db:5432/devlens
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=devlens-reviewer
AI_TIMEOUT_SECONDS=20
GITHUB_TOKEN=
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_TOKEN_EXPIRE_MINUTES=60
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
ANALYSIS_UPLOAD_DIR=.devlens/uploads
CHAT_MAX_FILES=8
CHAT_MAX_CONTEXT_CHARS=24000
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
