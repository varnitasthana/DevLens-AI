APP_NAME=DevLens API
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_DB=devlens
POSTGRES_USER=devlens
POSTGRES_PASSWORD=devlens-dev-password
DATABASE_URL=postgresql+psycopg://devlens:devlens-dev-password@db:5432/devlens
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=devlens-reviewer
AI_TIMEOUT_SECONDS=20
GITHUB_TOKEN=
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_TOKEN_EXPIRE_MINUTES=60
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
